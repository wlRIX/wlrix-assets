[Icon Theme]
Name=wlRIX
Comment=IRIX Indigo Magic icons

# Everything not drawn yet comes from Adwaita, and that is what makes a theme with one icon in
# it usable rather than a desktop full of blanks. Every consumer resolves a name through this
# list depth-first, so an icon added here simply starts winning over its Adwaita counterpart --
# there is no step where the theme has to be "finished" before it can be switched on.
#
# hicolor last because the spec says every theme inherits it, and because an application's own
# installed icon usually lives there rather than in any theme.
Inherits=Adwaita,hicolor

# A directory named here with no group of its own below is skipped, silently, by every
# implementation including wlRIX's own. Adding a directory means adding both.
Directories=scalable/places,scalable/mimetypes,scalable/devices,scalable/apps,scalable/status

# What a chooser shows to represent the theme. The one icon there is, for now.
Example=folder

# Scalable rather than a size ladder: these are SVGs and they are rasterized on demand, so one
# drawing serves 16px in a listing and 48px on the desktop. MinSize/MaxSize is the range a
# lookup will accept this directory for -- outside it the search falls through to Adwaita,
# which would be the wrong answer for a size we can render perfectly well. Hence a range wide
# enough to cover everything anything asks for.
#
# When a hand-tuned raster icon is wanted at a particular size, it goes in a sibling `48x48`
# directory with `Type=Fixed`: the resolver tries `.png` before `.svg`, so it will win at that
# size without this needing to change.
[scalable/places]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes

# Hardware, by the freedesktop device names: what a Bluetooth mouse or keyboard is drawn as,
# and the same drawings the Mouse and Keyboard settings panels ship as their own icons. The
# drives follow GVfs's split: `drive-*` is the empty drive, `media-*` the drive with something
# loaded, and `drive-harddisk-unmounted` is the one state of our own.
[scalable/devices]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices

# Applications, by the freedesktop generic names (accessories-text-editor): the drawing a
# wlRIX application ships under its own id, given to whatever else asks for the role.
[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

# Status indicators, under the `-symbolic` names the tray items ask for (wlrix-bluetooth's
# `bluetooth-*-symbolic`, wlrix-network's `network-wireless-*-symbolic`, wlrix-power's and
# UPower's `battery-*-symbolic`, fcitx5's `input-keyboard-symbolic`). The keyboard is a device
# rather than a status, but it is here because it is drawn for the tray: the large isometric
# `input-keyboard` in `scalable/devices` is a different picture.
#
# Drawn in color rather than as symbolic art: the tray paints an icon as the file says, with no
# recoloring, so Adwaita's fixed #2e3436 is close to invisible on the Gotham panel. A white face
# inside a black outline reads on a light panel and a dark one alike, the way the Indigo Magic
# icons always did.
#
# Drawn on a 22-unit grid, the tray's default icon size, so the strokes land on whole pixels
# there.
[scalable/status]
Size=22
MinSize=8
MaxSize=512
Type=Scalable
Context=Status
